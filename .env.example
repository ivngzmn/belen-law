# Contentful — create a space at contentful.com, then copy these values
# from Settings → API keys in your Contentful dashboard
CONTENTFUL_SPACE_ID=your_space_id_here
CONTENTFUL_ACCESS_TOKEN=your_delivery_api_token_here
CONTENTFUL_PREVIEW_TOKEN=your_preview_api_token_here

# Site URL — used for canonical URLs and Open Graph
PUBLIC_SITE_URL=https://www.belengomezlaw.com
