---
interface Props {
  heading?: string;
  subtext?: string;
}
const {
  heading = 'Get the representation you deserve.',
  subtext = 'Reach out for a confidential consultation. We respond within one business day.',
} = Astro.props;
---

<section class="section" style="position:relative;overflow:hidden;">
  <div class="container">
    <div class="cta-card" data-animate="fade-up" style="background:var(--primary);border-radius:var(--r-lg);color:#f4ece0;padding:clamp(40px,7vw,88px);position:relative;overflow:hidden;display:grid;grid-template-columns:1.4fr 1fr;gap:48px;align-items:center;">
      <!-- Arch backdrop -->
      <svg viewBox="0 0 600 400" preserveAspectRatio="xMidYMax slice" aria-hidden="true" style="position:absolute;inset:0;width:100%;height:100%;pointer-events:none;opacity:.08;">
        {[0,1,2,3].map(i => {
          const w = 200 + i * 110;
          const rx = w / 2;
          const x = 300 - rx;
          const y = 400 - (180 + i * 90);
          return <path key={i} d={`M${x} 400 L${x} ${y+rx} A${rx} ${rx} 0 0 1 ${x+w} ${y+rx} L${x+w} 400`} stroke="#fff" stroke-width="1" fill="none"/>;
        })}
      </svg>

      <div style="position:relative;">
        <div class="eyebrow" style="color:var(--accent-soft);">Schedule Consultation</div>
        <h2 class="display" style="font-size:clamp(36px,5vw,56px);color:#fff;margin-top:18px;max-width:14ch;">{heading}</h2>
        <p style="margin-top:16px;opacity:.85;max-width:480px;font-size:17px;">{subtext}</p>
        <div style="margin-top:32px;display:inline-flex;align-items:center;gap:12px;color:var(--accent-soft);opacity:.85;">
          <!-- Scales of justice icon -->
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">
            <line x1="12" y1="3" x2="12" y2="21"/>
            <line x1="6" y1="21" x2="18" y2="21"/>
            <line x1="2" y1="7" x2="22" y2="7"/>
            <circle cx="12" cy="4" r="1.2" fill="currentColor" stroke="none"/>
            <line x1="2" y1="7" x2="2" y2="14"/>
            <path d="M0 14 Q2 17.5 4 14"/>
            <line x1="22" y1="7" x2="22" y2="16"/>
            <path d="M20 16 Q22 19.5 24 16"/>
          </svg>
          <span style="font-family:var(--font-body);font-size:11px;letter-spacing:.2em;text-transform:uppercase;font-weight:600;">Your path forward</span>
        </div>
      </div>

      <div style="position:relative;display:flex;flex-direction:column;gap:14px;">
        <a class="btn btn-accent" href="/contact" style="padding:18px 28px;font-size:16px;">Schedule Consultation →</a>
        <a class="btn" href="tel:9512990114" style="background:transparent;border:1px solid rgba(255,255,255,.3);color:#fff;padding:18px 28px;font-size:16px;">Call 951-299-0114</a>
        <div style="font-size:13px;opacity:.7;margin-top:4px;">Mon–Thu 9:30am–5pm · Fri 9:30am–2pm</div>
      </div>
    </div>
  </div>
</section>

<style>
  @media (max-width: 820px) { .cta-card { grid-template-columns: 1fr !important; } }
</style>
