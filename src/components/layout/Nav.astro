---
const links = [
  { href: '/',         label: 'Home' },
  { href: '/about',    label: 'About' },
  { href: '/services', label: 'Services' },
  { href: '/media',    label: 'Media' },
  { href: '/contact',  label: 'Contact' },
];

const current = Astro.url.pathname;
---

<!-- Utility bar -->
<div class="util-bar">
  <div class="container" style="display:flex;align-items:center;justify-content:space-between;min-height:38px;gap:16px;">
    <div style="display:flex;gap:22px;align-items:center;flex-wrap:wrap;">
      <a href="tel:9512990114" style="display:inline-flex;gap:8px;align-items:center;">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
        </svg>
        <span>951-299-0114</span>
      </a>
      <span class="hide-xs" style="opacity:.7;">Mon–Thu 9:30am–5pm · Fri 9:30am–2pm</span>
    </div>
    <!-- Language toggle — client island -->
    <div id="lang-toggle" style="display:flex;align-items:center;gap:0;">
      <span style="opacity:.45;font-size:12px;margin-right:8px;">•</span>
      <button class="lang-btn active" data-lang="en" aria-pressed="true">EN</button>
      <span style="opacity:.4;">/</span>
      <button class="lang-btn" data-lang="es" aria-pressed="false">ES</button>
    </div>
  </div>
</div>

<!-- Main nav -->
<header id="site-header" style="position:sticky;top:0;z-index:80;background:var(--bg);border-bottom:1px solid transparent;transition:background .2s ease,border-color .2s ease,backdrop-filter .2s ease;">
  <div class="container" style="display:flex;align-items:center;gap:24px;padding:18px var(--pad-x);">
    <!-- Logo -->
    <a href="/" aria-label="Law Office of Belen Gomez, APC — home" style="display:inline-flex;align-items:center;gap:14px;">
      <img src="/img/brand-mark-transparent.png" alt="" aria-hidden="true" style="height:56px;width:auto;display:block;flex:none;" />
      <span aria-hidden="true" style="width:1px;align-self:stretch;margin:6px 0;background:var(--line);"></span>
      <span style="display:inline-flex;flex-direction:column;line-height:1;">
        <span style="font-family:var(--font-display);font-size:20px;font-weight:500;letter-spacing:-0.012em;color:var(--ink);">Belen Gomez</span>
        <span style="font-family:var(--font-body);font-size:10px;font-weight:600;letter-spacing:0.22em;text-transform:uppercase;color:var(--ink-soft);margin-top:6px;">Law Office · APC</span>
      </span>
    </a>

    <!-- Desktop links -->
    <nav aria-label="Main navigation" style="display:flex;gap:28px;margin-left:auto;align-items:center;" class="desktop-nav">
      {links.map(l => {
        const active = current === l.href || (l.href !== '/' && current.startsWith(l.href));
        return (
          <a
            href={l.href}
            aria-current={active ? 'page' : undefined}
            class="ul-link"
            style={`font-size:14.5px;font-weight:500;color:${active ? 'var(--primary)' : 'var(--ink)'};background-size:${active ? '100%' : '0'} 1px;background-image:linear-gradient(var(--accent),var(--accent));background-position:0 100%;background-repeat:no-repeat;padding-bottom:2px;transition:background-size .25s ease,color .2s ease;`}
          >{l.label}</a>
        );
      })}
      <a class="btn btn-primary" href="/contact" style="padding:11px 20px;font-size:14px;">Schedule Consultation</a>
    </nav>

    <!-- Mobile burger -->
    <button id="nav-open" aria-label="Open menu" aria-expanded="false" class="burger-btn" style="background:transparent;border:1px solid var(--line);border-radius:10px;padding:10px;display:none;">
      <svg width="20" height="14" viewBox="0 0 20 14" aria-hidden="true"><path d="M0 1h20M0 7h20M0 13h20" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
    </button>
  </div>
</header>

<!-- Mobile drawer overlay — outside <header> so backdrop-filter doesn't create a new containing block -->
<div id="nav-scrim" class="scrim" aria-hidden="true"></div>

<!-- Mobile drawer — outside <header> so position:fixed uses the viewport, not the header -->
<aside id="nav-drawer" aria-label="Mobile navigation" aria-hidden="true" style="position:fixed;top:0;right:0;bottom:0;width:min(360px,90vw);background:var(--bg);z-index:95;transform:translateX(102%);transition:transform .3s cubic-bezier(.2,.7,.2,1);box-shadow:-30px 0 80px -40px rgba(31,41,51,.35);padding:24px;display:flex;flex-direction:column;gap:20px;">
  <div style="display:flex;align-items:center;justify-content:space-between;">
    <a href="/" style="display:inline-flex;align-items:center;gap:12px;">
      <img src="/img/brand-mark-transparent.png" alt="" aria-hidden="true" style="height:44px;width:auto;" />
      <span style="font-family:var(--font-display);font-size:18px;font-weight:500;">Belen Gomez</span>
    </a>
    <button id="nav-close" aria-label="Close menu" style="background:transparent;border:none;padding:8px;">
      <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true"><path d="M3 3l14 14M17 3L3 17" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
    </button>
  </div>
  <nav style="display:flex;flex-direction:column;gap:4px;margin-top:12px;">
    {links.map(l => (
      <a href={l.href} style="font-family:var(--font-display);font-size:28px;font-weight:500;color:var(--ink);padding:10px 0;border-bottom:1px solid var(--line-soft);">{l.label}</a>
    ))}
  </nav>
  <a class="btn btn-primary" href="/contact" style="margin-top:auto;">Schedule Consultation</a>
  <div style="font-size:14px;color:var(--ink-soft);">
    <div>951-299-0114</div>
    <div style="margin-top:4px;">Mon–Thu 9:30am–5pm · Fri 9:30am–2pm</div>
  </div>
</aside>

<style>
  /* Mobile breakpoint — show burger, hide desktop nav */
  @media (max-width: 920px) {
    .desktop-nav { display: none !important; }
    .burger-btn  { display: inline-flex !important; }
  }

  /* Desktop guard — drawer and scrim must never appear above the breakpoint */
  @media (min-width: 921px) {
    #nav-drawer { display: none !important; }
    #nav-scrim  { display: none !important; }
  }

  @media (max-width: 600px) { .hide-xs { display: none; } }
</style>

<script>
  // Sticky header scroll effect
  const header = document.getElementById('site-header')!;
  const onScroll = () => {
    const scrolled = window.scrollY > 8;
    header.style.background = scrolled
      ? 'rgba(248,243,234,0.92)'
      : 'var(--bg)';
    header.style.backdropFilter = scrolled ? 'saturate(140%) blur(10px)' : 'none';
    (header.style as any).WebkitBackdropFilter = scrolled ? 'saturate(140%) blur(10px)' : 'none';
    header.style.borderBottom = scrolled ? '1px solid var(--line-soft)' : '1px solid transparent';
  };
  window.addEventListener('scroll', onScroll, { passive: true });

  // Mobile drawer
  const open  = document.getElementById('nav-open')!;
  const close = document.getElementById('nav-close')!;
  const scrim = document.getElementById('nav-scrim')!;
  const drawer = document.getElementById('nav-drawer')!;

  const MOBILE_BP = 920;

  function openDrawer() {
    if (window.innerWidth > MOBILE_BP) return; // never open on desktop
    drawer.style.transform = 'translateX(0)';
    drawer.setAttribute('aria-hidden', 'false');
    scrim.classList.add('open');
    open.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
  }
  function closeDrawer() {
    drawer.style.transform = 'translateX(102%)';
    drawer.setAttribute('aria-hidden', 'true');
    scrim.classList.remove('open');
    open.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
  }

  // Also close and restore body scroll if viewport is resized to desktop
  window.addEventListener('resize', () => {
    if (window.innerWidth > MOBILE_BP) closeDrawer();
  }, { passive: true });

  open.addEventListener('click', openDrawer);
  close.addEventListener('click', closeDrawer);
  scrim.addEventListener('click', closeDrawer);
</script>
