---
import BaseLayout from '../components/layout/BaseLayout.astro';
import PageHeader from '../components/shared/PageHeader.astro';
import FinalCTA from '../components/shared/FinalCTA.astro';

const RECOGNITION = [
  {
    label: 'California State Bar',
    sub: 'Active member in good standing',
    icon: `<svg width="18" height="18" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="16" y1="5" x2="16" y2="27"/><line x1="10" y1="27" x2="22" y2="27"/><line x1="5" y1="10" x2="27" y2="10"/><circle cx="16" cy="5" r="1.5" fill="currentColor" stroke="none"/><line x1="5" y1="10" x2="5" y2="18"/><path d="M2 18 Q5 22.5 8 18"/><line x1="27" y1="10" x2="27" y2="18"/><path d="M24 18 Q27 22.5 30 18"/></svg>`,
  },
  {
    label: 'AILA',
    sub: 'American Immigration Lawyers Association',
    icon: `<svg width="18" height="18" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="16" cy="16" r="11"/><line x1="5" y1="16" x2="27" y2="16"/><path d="M16 5 C12 8 10 12 10 16 C10 20 12 24 16 27"/><path d="M16 5 C20 8 22 12 22 16 C22 20 20 24 16 27"/><line x1="9" y1="10" x2="23" y2="10"/><line x1="9" y1="22" x2="23" y2="22"/></svg>`,
  },
  {
    label: 'IEBC',
    sub: 'Inland Empire Bar Association',
    icon: `<svg width="18" height="18" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12 L16 5 L28 12"/><rect x="7" y="12" width="3.5" height="13"/><rect x="14.25" y="12" width="3.5" height="13"/><rect x="21.5" y="12" width="3.5" height="13"/><line x1="4" y1="25" x2="28" y2="25"/><line x1="3" y1="28" x2="29" y2="28"/></svg>`,
  },
  {
    label: 'NCILC',
    sub: 'National Immigration Law Center — member',
    icon: `<svg width="18" height="18" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 8 L16 26"/><path d="M16 8 C12 6 6 6 4 8 L4 26 C6 24 12 24 16 26"/><path d="M16 8 C20 6 26 6 28 8 L28 26 C26 24 20 24 16 26"/><line x1="8" y1="12" x2="14" y2="12"/><line x1="8" y1="16" x2="14" y2="16"/><line x1="18" y1="12" x2="24" y2="12"/><line x1="18" y1="16" x2="24" y2="16"/></svg>`,
  },
  {
    label: 'SCLAN',
    sub: 'Southern California Legal Aid Network',
    icon: `<svg width="18" height="18" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="16" cy="6" r="3"/><circle cx="6" cy="24" r="3"/><circle cx="26" cy="24" r="3"/><line x1="14" y1="8" x2="8" y2="22"/><line x1="18" y1="8" x2="24" y2="22"/><line x1="9" y1="24" x2="23" y2="24"/></svg>`,
  },
  {
    label: 'SD Attorney Journal',
    sub: 'Featured interview, 2021',
    icon: `<svg width="18" height="18" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="4" width="22" height="26" rx="2"/><line x1="10" y1="10" x2="22" y2="10"/><line x1="10" y1="14" x2="22" y2="14"/><line x1="10" y1="18" x2="18" y2="18"/><rect x="10" y="22" width="5" height="5" rx="1"/><line x1="18" y1="23" x2="22" y2="23"/><line x1="18" y1="26" x2="22" y2="26"/></svg>`,
  },
];

const COMMUNITY = [
  { heading: 'Know Your Rights workshops', body: 'Belen regularly speaks at community events throughout Riverside County on immigration rights, DACA updates, and the consular process.' },
  { heading: 'Legal aid partnerships', body: 'The firm partners with Southern California legal aid organizations to connect low-income families with legal support they might not otherwise access.' },
  { heading: 'Spanish-language outreach', body: 'All community workshops are available in Spanish. Belen believes accessible information is itself a form of legal representation.' },
];
---

<BaseLayout
  title="Media & Recognition — Belen Gomez Law, Riverside CA"
  description="Coverage, recognition, and community work from Belen Gomez Law — featured in the San Diego Attorney Journal, AILA member, Inland Empire legal community leader."
>

  <PageHeader
    eyebrow="Media & recognition"
    title="A presence beyond <em>the office.</em>"
    intro="Belen Gomez Law is recognized across Southern California for its dedication to the immigrant community — in the courtroom, the press, and the neighborhood."
  />

  <!-- ── Magazine cover feature ────────────────────────────────────────────── -->
  <section class="section">
    <div class="container">
      <div style="display:grid;grid-template-columns:1fr 1.4fr;gap:clamp(36px,6vw,72px);align-items:center;" class="feature-grid">
        <!-- Cover -->
        <div style="border-radius:var(--r-card);overflow:hidden;box-shadow:0 32px 64px -24px rgba(18,60,53,.25);position:relative;">
          <img src="/img/magazine-cover.png" alt="San Diego Attorney Journal — Belen Gomez feature" style="width:100%;height:auto;display:block;"/>
          <div style="position:absolute;top:16px;left:16px;background:var(--primary);color:var(--accent-soft);font-size:10px;letter-spacing:.2em;text-transform:uppercase;padding:6px 12px;border-radius:4px;font-weight:600;">Featured</div>
        </div>
        <!-- Copy -->
        <div>
          <div class="eyebrow">San Diego Attorney Journal</div>
          <h2 class="display" style="font-size:clamp(26px,3.5vw,44px);margin-top:16px;max-width:18ch;">
            "A trusted voice in Southern California immigration law."
          </h2>
          <p style="margin-top:20px;color:var(--ink-soft);font-size:17px;line-height:1.7;max-width:52ch;">
            The San Diego Attorney Journal profiled Belen Gomez for her work in the Riverside immigrant community — covering her bilingual practice, her approach to humanitarian visa cases, and the gap she fills in legal representation for underserved families.
          </p>
          <a href="https://sdattorneyjournal.com" target="_blank" rel="noopener noreferrer"
            class="btn btn-ghost"
            style="margin-top:24px;padding:14px 0;font-size:15px;color:var(--primary);display:inline-flex;align-items:center;gap:8px;">
            Read the full feature →
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Recognition grid ──────────────────────────────────────────────────── -->
  <section class="section bg-alt">
    <div class="container">
      <div class="eyebrow center" style="text-align:center;">Credentials & affiliations</div>
      <h2 class="display" style="font-size:clamp(26px,3.5vw,42px);margin-top:16px;text-align:center;max-width:24ch;margin-left:auto;margin-right:auto;">
        Recognized by peers, trusted by clients.
      </h2>
      <div style="margin-top:44px;display:grid;grid-template-columns:repeat(3,1fr);gap:20px;" class="recognition-grid">
        {RECOGNITION.map((r) => (
          <div style="background:var(--card);border:1px solid var(--line-soft);border-radius:var(--r-card);padding:28px;display:flex;gap:16px;align-items:flex-start;">
            <div style="width:40px;height:40px;border-radius:50%;background:rgba(200,164,93,.15);border:1px solid rgba(200,164,93,.25);display:grid;place-items:center;flex:none;color:var(--primary);">
              <Fragment set:html={r.icon} />
            </div>
            <div>
              <div style="font-family:var(--font-display);font-size:16px;font-weight:600;">{r.label}</div>
              <div style="margin-top:4px;font-size:13px;color:var(--ink-soft);">{r.sub}</div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Articles & mentions ───────────────────────────────────────────────── -->
  <section class="section">
    <div class="container">
      <div class="eyebrow">Press & mentions</div>
      <div style="margin-top:32px;display:grid;grid-template-columns:repeat(2,1fr);gap:20px;" class="articles-grid">
        {[
          {
            source: 'San Diego Attorney Journal',
            year: '2021',
            headline: 'Bilingual Practice, Full Commitment: Inside Belen Gomez Law',
            excerpt: 'Gomez has built a practice that fills a critical gap — bilingual, community-rooted, and court-ready in every case she takes.',
          },
          {
            source: 'Inland Empire Business Journal',
            year: '2020',
            headline: 'Riverside Attorneys Making a Difference',
            excerpt: 'A roundup of legal professionals whose work extends beyond the courtroom into community advocacy.',
          },
          {
            source: 'AILA Quarterly',
            year: '2019',
            headline: 'Member Spotlight: Estate Planning for Mixed-Status Families',
            excerpt: 'Gomez discusses expanding her practice to address a growing need — estate documents designed for the realities of mixed-status households.',
          },
          {
            source: 'Univision Inland Empire',
            year: '2018',
            headline: 'Conozca sus derechos: Una abogada local explica el proceso',
            excerpt: 'A community segment on immigration rights, featuring Gomez speaking in Spanish on DACA, U Visas, and what families should know.',
          },
        ].map((a) => (
          <div style="background:var(--card);border:1px solid var(--line-soft);border-radius:var(--r-card);padding:28px;">
            <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:14px;">
              <div style="font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:var(--accent);font-weight:600;">{a.source}</div>
              <div style="font-size:12px;color:var(--ink-soft);">{a.year}</div>
            </div>
            <h3 style="font-family:var(--font-display);font-size:18px;font-weight:500;line-height:1.35;">{a.headline}</h3>
            <p style="margin-top:10px;color:var(--ink-soft);font-size:14px;line-height:1.6;">{a.excerpt}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Community impact ──────────────────────────────────────────────────── -->
  <section class="section bg-alt">
    <div class="container">
      <div style="display:grid;grid-template-columns:1fr 1.6fr;gap:clamp(36px,6vw,80px);align-items:center;" class="community-grid">
        <div>
          <div class="eyebrow">Community impact</div>
          <h2 class="display" style="font-size:clamp(26px,3.5vw,44px);margin-top:16px;max-width:18ch;">
            Legal access is itself a form of justice.
          </h2>
          <p style="margin-top:20px;color:var(--ink-soft);font-size:17px;line-height:1.65;max-width:48ch;">
            Beyond casework, Belen Gomez Law invests in the community through education, outreach, and partnership with organizations that serve immigrants who may not yet have access to legal representation.
          </p>
        </div>
        <div style="display:grid;gap:16px;">
          {COMMUNITY.map((c) => (
            <div style="background:var(--card);border:1px solid var(--line-soft);border-radius:var(--r-card);padding:24px;display:flex;gap:16px;align-items:flex-start;">
              <div style="width:10px;height:10px;border-radius:50%;background:var(--accent);flex:none;margin-top:7px;"></div>
              <div>
                <h3 style="font-family:var(--font-display);font-size:17px;font-weight:600;">{c.heading}</h3>
                <p style="margin-top:8px;color:var(--ink-soft);font-size:15px;line-height:1.6;">{c.body}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <FinalCTA />

</BaseLayout>

<style>
  @media (max-width: 860px) {
    .feature-grid,
    .community-grid,
    .container > div[style*="grid-template-columns:1fr 1.6fr"] { grid-template-columns: 1fr !important; }
    .recognition-grid { grid-template-columns: 1fr 1fr !important; }
    .articles-grid { grid-template-columns: 1fr !important; }
  }
  @media (max-width: 520px) {
    .recognition-grid { grid-template-columns: 1fr !important; }
  }
</style>
