---
import BaseLayout from '../../components/layout/BaseLayout.astro';
import FinalCTA from '../../components/shared/FinalCTA.astro';
import { getServices, getServiceBySlug } from '../../lib/contentful';

export const prerender = true;

export async function getStaticPaths() {
  const services = await getServices();
  return services.map((s) => ({
    params: { slug: s.fields.slug },
    props: { service: s },
  }));
}

const { service } = Astro.props;
const f = service.fields;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: f.title,
  description: f.summary,
  url: `https://www.belengomezlaw.com/services/${f.slug}`,
  provider: {
    '@type': 'LegalService',
    name: 'Belen Gomez Law',
    url: 'https://www.belengomezlaw.com',
    telephone: '+19512990114',
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Riverside',
      addressRegion: 'CA',
      addressCountry: 'US',
    },
  },
};

const faqSchema = f.faqs.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: f.faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.fields.question,
    acceptedAnswer: { '@type': 'Answer', text: faq.fields.answer },
  })),
} : null;

const allServices = await getServices();
const others = allServices.filter((s) => s.fields.slug !== f.slug).slice(0, 3);
---

<BaseLayout
  title={`${f.title} — Belen Gomez Law, Riverside CA`}
  description={f.summary}
  schema={schema}
>
  {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}

  <!-- ── Page header ───────────────────────────────────────────────────────── -->
  <section class="section tight" style="padding-bottom:0;position:relative;">
    <div class="container" style="position:relative;">
      <!-- Arch mark ornament -->
      <svg width="140" height="147" viewBox="0 0 60 64" fill="none" aria-hidden="true" style="position:absolute;right:var(--pad-x);top:-10px;color:var(--accent);opacity:.35;">
        <path d="M6 62 L6 30 A24 24 0 0 1 54 30 L54 62" stroke="currentColor" stroke-width="1.1" stroke-linejoin="round" stroke-linecap="round"/>
        <path d="M14 62 L14 32 A16 16 0 0 1 46 32 L46 62" stroke="currentColor" stroke-width="0.94" fill="none" stroke-linejoin="round" stroke-linecap="round" opacity=".55"/>
        <line x1="2" y1="62" x2="58" y2="62" stroke="currentColor" stroke-width="0.94" stroke-linecap="round"/>
      </svg>

      <nav aria-label="Breadcrumb" style="margin-bottom:20px;">
        <ol style="list-style:none;margin:0;padding:0;display:flex;gap:8px;font-size:13px;color:var(--ink-soft);">
          <li><a href="/" style="color:inherit;">Home</a></li>
          <li aria-hidden="true" style="opacity:.5;">›</li>
          <li><a href="/services" style="color:inherit;">Services</a></li>
          <li aria-hidden="true" style="opacity:.5;">›</li>
          <li aria-current="page" style="color:var(--ink);">{f.title}</li>
        </ol>
      </nav>

      <div data-animate="fade-up" class="eyebrow">Practice area</div>
      <h1 data-animate="fade-up" data-animate-delay="0.05" class="display" style="font-size:clamp(40px,6vw,76px);margin-top:24px;max-width:18ch;">
        {f.title}
      </h1>
      <p data-animate="fade-up" data-animate-delay="0.1" style="margin-top:22px;font-size:clamp(17px,1.4vw,20px);color:var(--ink-soft);max-width:64ch;line-height:1.55;">{f.summary}</p>
      <div style="margin-top:36px;color:var(--accent);opacity:.6;">
        <svg width="220" height="28" viewBox="0 0 280 64" fill="none" aria-hidden="true">
          <path d="M2 50 C 60 50, 80 14, 140 14 C 200 14, 220 50, 278 50" stroke="currentColor" stroke-width="1.1" stroke-linecap="round"/>
        </svg>
      </div>
    </div>
  </section>

  <!-- ── Detail section ───────────────────────────────────────────────────── -->
  <section class="section">
    <div class="container" style="display:grid;grid-template-columns:1.1fr 1fr;gap:clamp(36px,6vw,80px);align-items:start;">

      <!-- Main content -->
      <div>
        <p data-animate="fade-up" style="font-size:18px;line-height:1.7;color:var(--ink-soft);">{f.body}</p>

        <div style="margin-top:40px;">
          <div style="font-size:11px;letter-spacing:.18em;text-transform:uppercase;font-weight:600;color:var(--accent);">
            Who this helps
          </div>
          <ul data-animate="stagger" style="margin:0;margin-top:14px;padding:0;list-style:none;display:grid;gap:12px;">
            {f.whoHelps.map((h) => (
              <li style="display:flex;gap:12px;align-items:flex-start;">
                <span style="width:20px;height:20px;border-radius:6px;background:rgba(200,164,93,.2);display:grid;place-items:center;color:var(--primary);margin-top:2px;flex:none;">
                  <svg width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true"><path d="M1 5l3 3 5-6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </span>
                <span style="font-size:16px;">{h}</span>
              </li>
            ))}
          </ul>
        </div>

        <div data-animate="fade-up" style="margin-top:36px;display:flex;gap:14px;flex-wrap:wrap;">
          <a class="btn btn-primary" href="/contact" style="padding:14px 22px;font-size:15px;">Schedule consultation</a>
          <a class="btn btn-ghost" href="tel:9512990114" style="padding:14px 0;font-size:15px;color:var(--primary);">or call 951-299-0114 →</a>
        </div>
      </div>

      <!-- FAQ sidebar -->
      {f.faqs.length > 0 && (
        <div data-animate="fade-up" data-animate-delay="0.1" style="background:var(--bg-alt);border-radius:var(--r-card);padding:32px;">
          <div style="font-size:11px;letter-spacing:.18em;text-transform:uppercase;font-weight:600;color:var(--primary);">
            Common questions
          </div>
          <div data-animate="stagger" style="margin-top:8px;">
            {f.faqs.map((faq) => (
              <details class="faq" style="border-color:var(--line-soft);">
                <summary style="font-size:16px;">
                  {faq.fields.question}
                  <span class="plus">
                    <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M6 1v10M1 6h10" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
                  </span>
                </summary>
                <div class="ans" style="font-size:15px;">{faq.fields.answer}</div>
              </details>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>

  <!-- ── Other services ────────────────────────────────────────────────────── -->
  {others.length > 0 && (
    <section class="section bg-alt">
      <div class="container">
        <div data-animate="fade-up" class="eyebrow">Other practice areas</div>
        <div data-animate="stagger" style="margin-top:28px;display:grid;grid-template-columns:repeat(3,1fr);gap:18px;" class="other-grid">
          {others.map((s) => (
            <a href={`/services/${s.fields.slug}`} style="display:block;background:var(--card);border:1px solid var(--line-soft);border-radius:var(--r-card);padding:24px;text-decoration:none;transition:border-color .2s;">
              <h3 style="font-family:var(--font-display);font-size:17px;font-weight:500;">{s.fields.title}</h3>
              <p style="margin-top:8px;color:var(--ink-soft);font-size:14px;line-height:1.6;">{s.fields.summary}</p>
              <div style="margin-top:14px;font-size:13px;color:var(--primary);font-weight:500;">Learn more →</div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <FinalCTA />

</BaseLayout>

<style>
  @media (max-width: 820px) {
    /* Detail section: container IS the grid */
    .container[style*="grid-template-columns:1.1fr 1fr"] { grid-template-columns: 1fr !important; }
    .other-grid { grid-template-columns: 1fr 1fr !important; }
  }
  @media (max-width: 520px) {
    .other-grid { grid-template-columns: 1fr !important; }
  }
</style>
